# Copy this file to .env and fill in your own values.
DATABASE_URL=postgresql+psycopg://workouts_app:your-password@localhost:5432/workouts
TEST_DATABASE_URL=postgresql+psycopg://workouts_app:your-password@localhost:5432/workouts_test
# Comma-separated list of origins allowed to call the API (default: http://localhost:5173)
CORS_ORIGINS=http://localhost:5173